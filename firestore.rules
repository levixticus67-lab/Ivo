rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'company', 'projectType', 'budget',
          'location', 'timeline', 'description', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'company', 'projectType', 'budget',
          'location', 'timeline', 'description', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 120
        && request.resource.data.projectType in [
          'Commercial Construction', 'Residential Design & Build',
          'Civil Infrastructure', 'Structural Engineering', 'Interior Renovation', 'Other'
        ]
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 80
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 160
        && request.resource.data.timeline is string
        && request.resource.data.timeline.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 3000
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /siteSettings/{documentId} {
      allow read: if documentId == 'public' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
